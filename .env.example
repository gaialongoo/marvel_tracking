# ============================================================================
# Collegamento a Supabase. Copia questo file come ".env.local" (che NON viene
# caricato su GitHub) e incolla i valori presi da:
#   dashboard Supabase → Project Settings → API Keys / Data API
# Per GitHub Pages gli stessi due valori vanno messi in:
#   GitHub → Settings → Secrets and variables → Actions → Variables
# La chiave "publishable" (o "anon") è fatta per stare nel sito pubblico:
# i dati sono protetti dalle regole in supabase/schema.sql.
# ============================================================================
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo per scripts/tmdb-posters.mjs (NON entra nel sito): token "API Read Access Token" di themoviedb.org
TMDB_TOKEN=
