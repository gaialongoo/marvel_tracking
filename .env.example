# ============================================================================
# Indirizzo del backend (cartella worker/). Copia questo file come ".env.local"
# (che NON viene caricato su GitHub).
# - in locale, con il backend avviato da worker/ (npm run dev): http://localhost:8787
# - sito pubblicato: https://api.marveltracker.com
# Per GitHub Pages lo stesso valore va messo in:
#   GitHub → Settings → Secrets and variables → Actions → Variables
# L'app NON conosce più indirizzo e chiave di Supabase: stanno solo nei
# segreti del backend (vedi worker/wrangler.toml).
# ============================================================================
VITE_API_URL=http://localhost:8787

# Solo per scripts/tmdb-posters.mjs (NON entra nel sito): token "API Read Access Token" di themoviedb.org
TMDB_TOKEN=
